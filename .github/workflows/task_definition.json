{
    "family":"documentrag",
    "networkMode":"awsvpc",
    "cpu":"1024",
    "memory":"8192",
    "executionRoleArn":"arn:aws:iam::100627279444:role/ecsTaskExecutionRole",
    "requiresCompatibilities":[ "FARGATE"],
    "containerDefinitions":[
        {
            "name":"document-rag-container",
            "image":"100627279444.dkr.ecr.us-east-2.amazonaws.com/document-rag",
            "cpu": 1024,
            "essential":true,
            "portMappings":[
                {
                    "containerPort":8080,
                    "hostPort":8080,
                    "protocol":"tcp",
                    "name":"document-rag-container-8080-tcp",
                    "appProtocol":"http"
                }
            ],
            "environment":[
                {
                    "name":"ENV",
                    "value":"production"
                }
            ],
            "secrets": [
            {
            "name": "llm_api_keys",
            "valueFrom": "arn:aws:secretsmanager:us-east-2:100627279444:secret:llm_api_keys-bey7PW"
            }
            ],
            "logConfiguration":{
                "logDriver":"awslogs",
                "options":{
                    "awslogs-group":"/ecs/documentrag",
                    "awslogs-region":"us-east-2",
                    "awslogs-stream-prefix":"ecs",
                    "awslogs-create-group":"true"
                }
            }
        }
    ]
}
