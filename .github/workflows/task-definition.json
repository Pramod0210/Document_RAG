{
    "family":"documentrag",
    "networkMode":"awsvpc",
    "cpu":"256",
    "memory":"512",
    "executionRoleArn":"arn:aws:iam::100627279444:role/ecsTaskExecutionRole",
    "taskRoleArn":"arn:aws:iam::100627279444:role/ecsTaskExecutionRole",
    "requiresCompatibilities":[
        "FARGATE"
    ],
    "containerDefinitions":[
        {
            "name":"documentrag-container",
            "image":"arn:aws:iam::100627279444:user/document_rag_app:latest",
            "cpu":"256",
            "essential":true,
            "portMappings":[
                {
                    "containerPort":8000,
                    "hostPort":8000,
                    "protocol":"tcp",
                    "name":"documentrag-container-8080-tcp",
                    "appProtocol":"http"
                }
            ],
            "environment":[
                {
                    "name":"LANGCHAIN_PROJECT",
                    "value":"DOCUMENT RAG"
                }
            ],
            "secrets":[
                {
                    "name":"GROQ_API_KEY",
                    "valueFrom":"arn:aws:ssm:us-east-2:100627279444:secret/GROQ_API_KEY"
                },
                {
                    "name":"GOOGLE_API_KEY",
                    "valueFrom":"arn:aws:ssm:us-east-2:100627279444:secret/GOOGLE_API_KEY"
                }

            ],
            "logConfiguration":{
                "logDriver":"awslogs",
                "options":{
                    "awslogs-group":"documentrag",
                    "awslogs-region":"us-east-2",
                    "awslogs-stream-prefix":"documentrag",
                    "awslogs-create-group":"false",
                    "mode":"non-blocking",
                    "max-buffer-size":"25m"
                }
            }
        }
    ]
}