{
    "family":"documentrag",
    "networkMode":"awsvpc",
    "cpu":"256",
    "memory":"512",
    "executionRoleArn":"arn:aws:iam::100627279444:role/ecsTaskExecutionRole",
    "taskRoleArn":"arn:aws:iam::100627279444:role/ecsTaskExecutionRole",
    "requiresCompatibilities":[
        "FARGATE"
    ],
    "containerDefinitions":[
        {
            "name":"document-rag-container",
            "image":"100627279444.dkr.ecr.us-east-2.amazonaws.com/document-rag",
            "cpu": 256,
            "essential":true,
            "portMappings":[
                {
                    "containerPort":8000,
                    "hostPort":8000,
                    "protocol":"tcp",
                    "name":"document-rag-container-8080-tcp",
                    "appProtocol":"http"
                }
            ],
            "environment":[
                {
                    "name":"LANGCHAIN_PROJECT",
                    "value":"DOCUMENT_RAG"
                }
            ],
            "secrets":[
                {
                    "name":"GROQ_API_KEY",
                    "valueFrom":"arn:aws:secretsmanager:us-east-2:100627279444:secret:llm_api_keys-bey7PW:GROQ_API_KEY"
                },
                {
                    "name":"GOOGLE_API_KEY",
                    "valueFrom":"arn:aws:secretsmanager:us-east-2:100627279444:secret:llm_api_keys-bey7PW:GOOGLE_API_KEY"
                }

            ],
            "logConfiguration":{
                "logDriver":"awslogs",
                "options":{
                    "awslogs-group":"/ecs/documentrag",
                    "awslogs-region":"us-east-2",
                    "awslogs-stream-prefix":"ecs",
                    "awslogs-create-group":"true",
                    "mode":"non-blocking",
                    "max-buffer-size":"25m"
                }
            }
        }
    ]
}